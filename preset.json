{
  "id": "core",
  "name": "核心护栏",
  "description": "任何项目都该装的最小保险:拦截直推主干、危险 shell 命令、密钥写入、凭证读取、丢弃工作区的 git 操作。全部 fail-open,运行时可用 kimi-boost guard 调整。",
  "tags": [
    "core",
    "guardrails",
    "security",
    "cross-stack"
  ],
  "version": "1.1.0",
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "script": "protect-main.mjs",
      "timeout": 5
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "script": "block-dangerous.mjs",
      "timeout": 5
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "script": "git-destructive.mjs",
      "timeout": 5
    },
    {
      "event": "PreToolUse",
      "matcher": "Write",
      "script": "secret-scan.mjs",
      "timeout": 5
    },
    {
      "event": "PreToolUse",
      "matcher": "Edit",
      "script": "secret-scan.mjs",
      "timeout": 5
    },
    {
      "event": "PreToolUse",
      "matcher": "Read",
      "script": "protect-credentials.mjs",
      "timeout": 5,
      "args": ["--tool=read"]
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "script": "protect-credentials.mjs",
      "timeout": 5,
      "args": ["--tool=bash"]
    }
  ]
}
